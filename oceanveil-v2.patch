+                titles.setdefault(str(t['id']), record(t, saved.get(str(t['id']), {})))
+            ids = [str(t['id']) for t in found]
+        rows.append({'catalog_id': f'oceanveil-home-{key}', 'name': str(s.get('header') or key).strip(),
